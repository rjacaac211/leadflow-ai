# --- Required ---
# PostgreSQL — shared by Prisma models and the LangGraph checkpointer tables
DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow

# Anthropic Claude — the only key required to run the full pipeline in mock mode
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional model override (defaults to claude-opus-4-8) ---
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Inbound webhook auth ---
# Shared secret for POST /api/webhooks/* (sent as X-API-Key by n8n/Zapier).
# If unset, webhooks are open — dev/demo only; always set it in production.
WEBHOOK_API_KEY=change-me

# --- Integrations (each degrades to a logged no-op "mock mode" when unset) ---
# HubSpot account-scoped token (free tier works): contacts + notes sync.
# In HubSpot's UI: Settings > Integrations > Development > Keys > Service Keys
# (their newer replacement for "Private Apps"). Only needs the
# crm.objects.contacts.read/write scopes — there's no separate notes scope.
# HUBSPOT_ACCESS_TOKEN=pat-na1-...

# Resend: outbound email sending. On an unverified account, Resend only lets
# you send to the exact email you signed up with (no +alias) until you verify
# a domain at resend.com/domains.
# RESEND_API_KEY=re_...
# OUTREACH_FROM_EMAIL=LeadFlow <outreach@yourdomain.com>

# Slack incoming webhook: hot-lead notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Slack interactive approval (Block Kit buttons on the outreach-draft message,
# clicked straight through to /api/leads/:id/approve|reject via the n8n
# workflow in automation/n8n-slack-approval-workflow.json). Requires a real
# Slack App: bot token needs the chat:write scope; approval channel is where
# the bot posts (a channel ID like C0123456, or a name the bot has joined).
# Without these two, approvalGateNode falls back to the plain SLACK_WEBHOOK_URL
# notification above (or full mock mode if that's unset too).
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APPROVAL_CHANNEL=C0123456

# Signing secret from the same Slack App's "Basic Information" page — verifies
# that interaction webhooks hitting n8n really came from Slack. Required only
# by the n8n Slack-approval workflow, not the server.
# SLACK_SIGNING_SECRET=...

# --- Server ---
PORT=4000
# LOG_LEVEL=info
