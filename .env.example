# --- Required ---
# PostgreSQL — shared by Prisma models and the LangGraph checkpointer tables
DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow

# Anthropic Claude — the only key required to run the full pipeline in mock mode
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional model override (defaults to claude-opus-4-8) ---
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Inbound webhook auth ---
# Shared secret for POST /api/webhooks/* (sent as X-API-Key by n8n/Zapier).
# If unset, webhooks are open — dev/demo only; always set it in production.
WEBHOOK_API_KEY=change-me

# --- Integrations (each degrades to a logged no-op "mock mode" when unset) ---
# HubSpot private app token (free tier works): contacts + notes sync
# HUBSPOT_ACCESS_TOKEN=pat-na1-...

# Resend: outbound email sending
# RESEND_API_KEY=re_...
# OUTREACH_FROM_EMAIL=LeadFlow <outreach@yourdomain.com>

# Slack incoming webhook: hot-lead notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Server ---
PORT=4000
# LOG_LEVEL=info
